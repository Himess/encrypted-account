{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node", "mocha", "chai"]
  },
  "include": ["hardhat.config.ts", "test/**/*.ts", "scripts/**/*.ts", "sdk/**/*.ts"]
}
