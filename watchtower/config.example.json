{
  "network": {
    "chainId": 11155111,
    "rpcUrls": ["https://ethereum-sepolia-rpc.publicnode.com", "https://sepolia.gateway.tenderly.co"],
    "fhevm": "sepolia"
  },
  "guardianKey": { "envFile": "watchtower/.env", "var": "WATCHTOWER_KEY" },
  "pollSeconds": 4,
  "maxLogRange": 2000,
  "stateFile": "watchtower/data/state.json",
  "deliveryLog": "watchtower/data/deliveries.jsonl",
  "restrictOnTripwire": true,
  "channels": {
    "telegram": { "envFile": "watchtower/.env", "botTokenVar": "TELEGRAM_BOT_TOKEN" },
    "email": { "envFile": "watchtower/.env", "from": "watchtower@example.org" },
    "fake": { "file": "watchtower/data/notices.jsonl", "console": true }
  },
  "accounts": [
    {
      "label": "My account",
      "address": "0x0000000000000000000000000000000000000001",
      "fromBlock": 0,
      "owner": [{ "channel": "telegram", "to": "123456789" }],
      "trusted": [{ "channel": "email", "to": "trusted.person@example.org", "name": "a person I trust" }],
      "duressNote": "If you get this, call me on the landline."
    }
  ]
}
