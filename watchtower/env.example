# Copy to watchtower/.env (git-ignored) and fill in. Never commit the filled file.
# The watchtower (guardian) key: it may decrypt what accounts allow it and restrict an account; it cannot move funds.
WATCHTOWER_KEY=
# Telegram bot token from @BotFather. Without it, Telegram messages go to the fake channel (watchtower/data/notices.jsonl).
TELEGRAM_BOT_TOKEN=
# SMTP server for e-mail. Without SMTP_HOST (and "from" in the config), e-mails go to the fake channel.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
