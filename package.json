{
  "name": "encrypted-account",
  "version": "0.1.0",
  "private": true,
  "description": "Research prototype: an ERC-4337 smart account whose PIN, spending limits, random tripwire and known lists are encrypted with Zama FHEVM and enforced on-chain",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "node scripts/run-tests.mjs",
    "test:record": "node scripts/run-tests.mjs --record",
    "test:sdk": "mocha -r ts-node/register sdk/test/**/*.test.ts --timeout 120000",
    "test:all": "npm run test:sdk && npm test",
    "size": "hardhat run scripts/contract-sizes.ts",
    "cost-model": "hardhat test test/CostModel.test.ts",
    "e1:sepolia": "hardhat run scripts/sepolia-e1.ts --network sepolia",
    "burner": "hardhat run scripts/burner.ts",
    "sepolia:estimate": "hardhat run scripts/sepolia/estimate-funding.ts",
    "sepolia:wait": "hardhat run scripts/sepolia/wait-funding.ts",
    "secrets:check": "hardhat run scripts/check-secrets.ts",
    "bench:build": "node bench/build.mjs",
    "web:abi": "node web/gen-abi.mjs",
    "web:build": "node web/build.mjs",
    "web:serve": "node web/serve.mjs 8790",
    "web:test": "node web/test/run.mjs",
    "clean": "hardhat clean",
    "test:hh": "hardhat test",
    "vectors": "node sdk/scripts/gen-vectors.mjs"
  },
  "dependencies": {
    "@account-abstraction/contracts": "0.8.0",
    "@fhevm/solidity": "0.13.4",
    "@openzeppelin/contracts": "5.6.1",
    "encrypted-types": "0.0.4",
    "hash-wasm": "4.13.0"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.13.0-1",
    "@fhevm/sdk": "0.13.7",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.30",
    "chai": "^4.5.0",
    "esbuild": "^0.28.2",
    "ethers": "^6.17.0",
    "hardhat": "2.29.1",
    "mocha": "^11.7.5",
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
